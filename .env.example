# ==============================================================================
# DoableForge Enterprise Configuration (Template)
# Copy this file to .env and fill in your credentials.
# NOTE: Never commit your actual .env file to Git!
# ==============================================================================

# Database
DATABASE_URL=sqlite:///./doableforge.db

# ------------------------------------------------------------------------------
# Email SMTP Dispatch Setup
#
# Option A: Hostinger (Recommended for @doableforge.com)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=contact@doableforge.com
# SMTP_PASSWORD=your-email-password
# SMTP_USE_TLS=false
# SMTP_USE_SSL=true
#
# Option B: Google / Gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-16-char-google-app-password
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@doableforge.com
SMTP_PASSWORD=your-secure-password
SMTP_USE_TLS=false
SMTP_USE_SSL=true

# Where inbound client and freelancer inquiries are delivered:
CONTACT_RECIPIENT_EMAIL=contact@doableforge.com

# Automatically send receipt acknowledgment to the client/freelancer:
SEND_CLIENT_CONFIRMATION=true

# ------------------------------------------------------------------------------
# Render Deployment & Keep-Alive Settings
# ------------------------------------------------------------------------------
# Server port (Render sets this dynamically via $PORT)
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

# Render automated sleep prevention keep-alive worker:
# Runs an asynchronous heartbeat every 5-10 seconds to keep Render free web service awake
ENABLE_KEEP_ALIVE=true
KEEP_ALIVE_INTERVAL=10

# Render public URL (automatically provided on Render as RENDER_EXTERNAL_URL)
RENDER_EXTERNAL_URL=https://doableforge.onrender.com

# CORS & Frontend connectivity
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,*
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Frontend environment variable (when deploying frontend to Vercel/Netlify/Render)
VITE_API_URL=https://doableforge.onrender.com/api
