# ==============================================================================
# DoableForge Enterprise Configuration (Template)
# Copy this file to .env and fill in your credentials.
# NOTE: Never commit your actual .env file to Git!
# ==============================================================================

# Database
DATABASE_URL=sqlite:///./doableforge.db

# ------------------------------------------------------------------------------
# Email SMTP Dispatch Setup
#
# Option A: Hostinger (Recommended for @doableforge.com)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=contact@doableforge.com
# SMTP_PASSWORD=your-email-password
# SMTP_USE_TLS=false
# SMTP_USE_SSL=true
#
# Option B: Google / Gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-16-char-google-app-password
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@doableforge.com
SMTP_PASSWORD=your-secure-password
SMTP_USE_TLS=false
SMTP_USE_SSL=true

# Where inbound client and freelancer inquiries are delivered:
CONTACT_RECIPIENT_EMAIL=contact@doableforge.com

# Automatically send receipt acknowledgment to the client/freelancer:
SEND_CLIENT_CONFIRMATION=true
